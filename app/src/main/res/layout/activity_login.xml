<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="32dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingEnd="32dp">

                <ImageView
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_myth_emblem" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.TheMyth.Hero" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.3"
                    android:text="@string/splash_tagline"
                    android:textAppearance="@style/TextAppearance.TheMyth.Caption"
                    android:textColor="@color/cyan" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.TheMyth.Panel"
                android:layout_width="380dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_title"
                    android:textAppearance="@style/TextAppearance.TheMyth.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/login_subtitle"
                    android:textAppearance="@style/TextAppearance.TheMyth.Body"
                    android:textColor="@color/text_muted" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnGoogle"
                    style="@style/Widget.TheMyth.Button.Google"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:drawableStart="@drawable/ic_google"
                    android:drawablePadding="12dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/login_google" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnGuest"
                    style="@style/Widget.TheMyth.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@drawable/ic_guest"
                    android:drawablePadding="12dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/login_guest" />

                <TextView
                    android:id="@+id/tvLoginError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/danger"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/login_terms"
                    android:textAppearance="@style/TextAppearance.TheMyth.Caption" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="@color/cyan" />

            <TextView
                android:id="@+id/tvLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/login_connecting"
                android:textAppearance="@style/TextAppearance.TheMyth.Body" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
